PROJECT_NAME=Agenda financiera
PROJECT_TAGLINE=Tus ingresos, gastos y deudas en un solo lugar
PORT=5028
FLASK_ENV=development
SECRET_KEY=
AUTH_MODE=shared_login
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
SESSION_COOKIE_NAME=session_finanzas
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
DATABASE_URL=sqlite:///instance/finanzas.sqlite3
LOG_LEVEL=INFO
APP_TIMEZONE=America/Mexico_City
# Amount in cents; 0 disables the income comparison.
QUINCENAL_INCOME_CENTS=0
# Optional Gmail integration; configure privately.
GMAIL_EMAIL=
XML_SENDER_EMAIL=
